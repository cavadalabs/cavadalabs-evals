{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/metrics/1.0.0",
  "title": "CavadaLabs Run Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "observations",
    "pass",
    "fail",
    "invalid",
    "error",
    "skipped",
    "pass_rate",
    "pass_rate_ci",
    "pass_rate_ci95",
    "officially_valid",
    "analysis_unit",
    "evaluation_cases",
    "target_observations",
    "evidence_reconciliation",
    "constructs",
    "aggregate_scope",
    "legacy_overall_metrics_claimable",
    "pass_rate_bootstrap_ci",
    "pass_rate_stratified_bootstrap_ci",
    "slices",
    "slice_disparities",
    "stability",
    "judge_calibration",
    "performance",
    "performance_by_phase",
    "budgets",
    "gate_failures",
    "aborted"
  ],
  "properties": {
    "total": {"type": "integer", "minimum": 0},
    "observations": {"type": "integer", "minimum": 0},
    "pass": {"type": "integer", "minimum": 0},
    "fail": {"type": "integer", "minimum": 0},
    "invalid": {"type": "integer", "minimum": 0},
    "error": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "pass_rate": {"$ref": "#/$defs/rate"},
    "pass_rate_ci": {"$ref": "#/$defs/confidenceInterval"},
    "pass_rate_ci95": {"oneOf": [{"$ref": "#/$defs/interval95"}, {"type": "null"}]},
    "officially_valid": {"type": "boolean"},
    "analysis_unit": {"enum": ["case", "scenario"]},
    "evaluation_cases": {"type": "integer", "minimum": 0},
    "target_observations": {"type": "integer", "minimum": 0},
    "evidence_reconciliation": {"$ref": "#/$defs/evidenceReconciliation"},
    "constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aggregate_scope": {"enum": ["single-construct", "not-applicable"]},
    "legacy_overall_metrics_claimable": {"type": "boolean"},
    "case_level": {"$ref": "#/$defs/baseMetrics"},
    "case_categories": {"type": "array", "items": {"type": "object"}},
    "pass_rate_bootstrap_ci": {"$ref": "#/$defs/bootstrapInterval"},
    "pass_rate_stratified_bootstrap_ci": {"$ref": "#/$defs/bootstrapInterval"},
    "distribution_shift": {"type": "object"},
    "slices": {"$ref": "#/$defs/slices"},
    "slice_disparities": {"$ref": "#/$defs/sliceDisparities"},
    "stability": {"$ref": "#/$defs/stability"},
    "judge_calibration": {"type": "object", "additionalProperties": {"type": "object"}},
    "performance": {"$ref": "#/$defs/performance"},
    "performance_by_phase": {"$ref": "#/$defs/performanceByPhase"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "cost": {"$ref": "#/$defs/cost"},
    "gate_failures": {"type": "array", "items": {"$ref": "#/$defs/gateFailure"}},
    "aborted": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"aggregate_scope": {"const": "not-applicable"}}, "required": ["aggregate_scope"]},
      "then": {
        "properties": {
          "constructs": {"minItems": 2},
          "legacy_overall_metrics_claimable": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"aggregate_scope": {"const": "single-construct"}}, "required": ["aggregate_scope"]},
      "then": {
        "properties": {
          "constructs": {"maxItems": 1},
          "legacy_overall_metrics_claimable": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"analysis_unit": {"const": "scenario"}}, "required": ["analysis_unit"]},
      "then": {"required": ["case_level", "case_categories"]}
    }
  ],
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "confidence"],
      "properties": {
        "lower": {"$ref": "#/$defs/rate"},
        "upper": {"$ref": "#/$defs/rate"},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "interval95": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {"lower": {"$ref": "#/$defs/rate"}, "upper": {"$ref": "#/$defs/rate"}}
    },
    "bootstrapInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "confidence", "samples", "seed"],
      "properties": {
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "samples": {"type": "integer", "minimum": 100},
        "seed": {"type": "integer"},
        "strata": {"type": "integer", "minimum": 0}
      }
    },
    "baseMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "observations", "pass", "fail", "invalid", "error", "skipped", "pass_rate", "pass_rate_ci", "pass_rate_ci95", "officially_valid"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "observations": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "pass_rate": {"$ref": "#/$defs/rate"},
        "pass_rate_ci": {"$ref": "#/$defs/confidenceInterval"},
        "pass_rate_ci95": {"oneOf": [{"$ref": "#/$defs/interval95"}, {"type": "null"}]},
        "officially_valid": {"type": "boolean"}
      }
    },
    "evidenceReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "expected_observations", "case_results", "target_requests", "target_responses", "judge_requests", "judge_outputs", "errors"],
      "properties": {
        "valid": {"type": "boolean"},
        "expected_observations": {"type": "integer", "minimum": 0},
        "case_results": {"type": "integer", "minimum": 0},
        "target_requests": {"type": "integer", "minimum": 0},
        "target_responses": {"type": "integer", "minimum": 0},
        "judge_requests": {"type": "integer", "minimum": 0},
        "judge_outputs": {"type": "integer", "minimum": 0},
        "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "slice": {"type": "object", "additionalProperties": {"$ref": "#/$defs/baseMetrics"}},
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_domain", "severity", "language", "locale", "split", "operating_condition"],
      "properties": {
        "risk_domain": {"$ref": "#/$defs/slice"},
        "severity": {"$ref": "#/$defs/slice"},
        "language": {"$ref": "#/$defs/slice"},
        "locale": {"$ref": "#/$defs/slice"},
        "split": {"$ref": "#/$defs/slice"},
        "operating_condition": {"$ref": "#/$defs/slice"}
      }
    },
    "sliceDisparities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_domain", "severity", "language", "locale", "split", "operating_condition"],
      "properties": {
        "risk_domain": {"$ref": "#/$defs/rate"},
        "severity": {"$ref": "#/$defs/rate"},
        "language": {"$ref": "#/$defs/rate"},
        "locale": {"$ref": "#/$defs/rate"},
        "split": {"$ref": "#/$defs/rate"},
        "operating_condition": {"$ref": "#/$defs/rate"}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "max", "mean", "median", "stdev", "p50", "p90", "p95", "p99"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "mean": {"type": "number"},
        "median": {"type": "number"},
        "stdev": {"type": "number", "minimum": 0},
        "p50": {"type": "number"},
        "p90": {"type": "number"},
        "p95": {"type": "number"},
        "p99": {"type": "number"}
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_pass_fraction", "stable_case_fraction", "judge_agreement", "judge_score"],
      "properties": {
        "case_pass_fraction": {"$ref": "#/$defs/distribution"},
        "stable_case_fraction": {"$ref": "#/$defs/rate"},
        "judge_agreement": {"$ref": "#/$defs/distribution"},
        "judge_score": {"$ref": "#/$defs/distribution"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_latency_ms", "evaluation_duration_ms", "target_response_bytes", "input_tokens", "output_tokens", "ttft_ms", "output_tokens_per_second", "elapsed_seconds", "observations_per_second", "target_calls_per_second", "observation_success_rate", "observation_error_rate"],
      "properties": {
        "target_latency_ms": {"$ref": "#/$defs/distribution"},
        "evaluation_duration_ms": {"$ref": "#/$defs/distribution"},
        "target_response_bytes": {"$ref": "#/$defs/distribution"},
        "input_tokens": {"$ref": "#/$defs/distribution"},
        "output_tokens": {"$ref": "#/$defs/distribution"},
        "ttft_ms": {"$ref": "#/$defs/distribution"},
        "output_tokens_per_second": {"$ref": "#/$defs/distribution"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "observations_per_second": {"type": "number", "minimum": 0},
        "target_calls_per_second": {"type": "number", "minimum": 0},
        "observation_success_rate": {"$ref": "#/$defs/rate"},
        "observation_error_rate": {"$ref": "#/$defs/rate"}
      }
    },
    "performanceByPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold", "warmup", "steady", "soak"],
      "properties": {
        "cold": {"$ref": "#/$defs/distribution"},
        "warmup": {"$ref": "#/$defs/distribution"},
        "steady": {"$ref": "#/$defs/distribution"},
        "soak": {"$ref": "#/$defs/distribution"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_calls", "judge_calls", "total_tokens", "exhausted"],
      "properties": {
        "target_calls": {"type": "integer", "minimum": 0},
        "judge_calls": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "number", "minimum": 0},
        "exhausted": {"type": "boolean"}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "source", "effective_at", "input_tokens", "output_tokens", "judge_input_tokens", "judge_output_tokens", "estimated_total"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "effective_at": {"type": "string", "minLength": 1},
        "input_tokens": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "number", "minimum": 0},
        "judge_input_tokens": {"type": "number", "minimum": 0},
        "judge_output_tokens": {"type": "number", "minimum": 0},
        "estimated_total": {"type": "number", "minimum": 0}
      }
    },
    "gateFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "metric", "minimum", "actual"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"},
        "actual": {"type": ["number", "null"]}
      }
    }
  }
}
