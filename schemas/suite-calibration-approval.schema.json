{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/suite-calibration-approval/2.0.0",
  "title": "CavadaLabs Independent Suite Calibration Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_version",
    "approval_id",
    "scope",
    "status",
    "independent",
    "calibration_sha256",
    "approver_id",
    "approver_qualification_evidence",
    "approver_qualification_evidence_sha256",
    "conflicts",
    "decision_rationale",
    "approved_at",
    "expires_at"
  ],
  "properties": {
    "approval_version": {"const": "2.0.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "scope": {"const": "suite-calibration"},
    "status": {"enum": ["passed", "failed", "withdrawn"]},
    "independent": {"type": "boolean"},
    "calibration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approver_id": {"type": "string", "minLength": 1},
    "approver_qualification_evidence": {"$ref": "#/$defs/path"},
    "approver_qualification_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "conflicts": {"type": "string", "minLength": 1},
    "decision_rationale": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}
}
