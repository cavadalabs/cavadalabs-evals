{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/corpus-source-run-evidence/1.0.0",
  "title": "CavadaLabs Qualification Corpus Source Run Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "run_id",
    "producer_id",
    "source_suite",
    "system",
    "completed_at",
    "record_count",
    "source_items_subject_sha256"
  ],
  "properties": {
    "evidence_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "source_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "dataset_sha256", "rubric_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rubric_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "revision"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "record_count": {"type": "integer", "minimum": 1},
    "source_items_subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
