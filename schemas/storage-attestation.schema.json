{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/storage-attestation/1.0.0",
  "title": "CavadaLabs Storage Security Attestation",
  "type": "object",
  "required": ["attestation_id", "approver", "encryption_at_rest", "immutability", "access_policy_reference", "audit_log_reference", "retention_policy_reference", "backup_restore_reference", "effective_at", "expires_at"],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "encryption_at_rest": {"type": "boolean"},
    "immutability": {"type": "boolean"},
    "access_policy_reference": {"type": "string", "minLength": 1},
    "audit_log_reference": {"type": "string", "minLength": 1},
    "retention_policy_reference": {"type": "string", "minLength": 1},
    "backup_restore_reference": {"type": "string", "minLength": 1},
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
