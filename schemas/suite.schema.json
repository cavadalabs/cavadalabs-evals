{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/suite/1.0.0",
  "title": "CavadaLabs Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "name", "version", "status", "description", "dataset", "rubric", "data_classification", "governance", "gates"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "candidate", "calibrated", "approved", "deprecated", "retired"]},
    "description": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "rubric": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["public", "synthetic", "internal", "confidential", "restricted"]},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rubric_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "temperature": {"type": "number", "minimum": 0, "maximum": 2},
    "max_tokens": {"type": "integer", "minimum": 1},
    "official_min_repetitions": {"type": "integer", "minimum": 1},
    "official_min_judge_repetitions": {"type": "integer", "minimum": 1},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "purpose", "intended_use", "prohibited_use", "license", "origin", "created_at", "retention", "personal_data", "legal_basis_reference", "rotation_due", "contamination_status", "canary_strategy", "known_leaks", "representativeness", "transfer_restrictions", "near_duplicate_threshold"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "intended_use": {"type": "string", "minLength": 1},
        "prohibited_use": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date"},
        "retention": {"type": "string", "minLength": 1},
        "personal_data": {"type": "string", "minLength": 1},
        "legal_basis_reference": {"type": "string", "minLength": 1},
        "rotation_due": {"type": "string", "format": "date"},
        "contamination_status": {"type": "string", "minLength": 1},
        "canary_strategy": {"type": "string", "minLength": 1},
        "known_leaks": {"type": "string", "minLength": 1},
        "representativeness": {"type": "string", "minLength": 1},
        "transfer_restrictions": {"type": "string", "minLength": 1},
        "near_duplicate_threshold": {"type": "number", "minimum": 0.8, "exclusiveMaximum": 1},
        "semantic_duplicate_threshold": {"type": "number", "minimum": 0.8, "maximum": 1},
        "minimum_category_cases": {"type": "integer", "minimum": 1},
        "maximum_category_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "target": {"type": "object"},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assets": {"type": "object"},
    "metrics": {"type": "object"},
    "judge": {"type": "object"},
    "statistics": {"type": "object"},
    "report": {"type": "object"},
    "splits": {"type": "object"},
    "calibration": {"type": "object"},
    "pricing": {"type": "object"},
    "network": {"type": "object"},
    "dataset_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_review_status", "semantic_review_evidence_sha256", "semantic_detector", "semantic_detector_revision", "cross_split_reviewed"],
      "properties": {
        "semantic_review_status": {"enum": ["pending", "passed", "failed", "expired"]},
        "semantic_review_evidence_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
        "semantic_detector": {"type": "string"},
        "semantic_detector_revision": {"type": "string"},
        "cross_split_reviewed": {"type": "boolean"}
      }
    }
  }
}
