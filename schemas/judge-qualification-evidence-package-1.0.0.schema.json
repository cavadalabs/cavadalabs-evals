{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/judge-qualification-evidence-package/1.0.0",
  "title": "CavadaLabs Judge Qualification Evidence Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_version", "artifact_type", "protocol_version", "created_at", "claim_scope", "artifacts"],
  "properties": {
    "package_version": {"const": "1.0.0"},
    "artifact_type": {"const": "judge-qualification-evidence-package"},
    "protocol_version": {"const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "claim_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256", "artifact_type", "media_type", "schema_version"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "artifact_type": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "schema_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
