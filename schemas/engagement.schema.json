{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/engagement/1.1.0",
  "title": "CavadaLabs Evaluation Engagement Governance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["engagement_version", "engagement_id", "status", "cavadalabs_roles", "counterparty_roles", "scope", "suite", "sut", "execution_owner_id", "commercial_owner_id", "system_owner_reference", "jurisdictions", "requested_claims", "permitted_claims", "prohibited_claims", "conflicts_assessed", "conflicts", "complaints_process_reference", "appeals_process_reference", "correction_revocation_reference", "disclosure_policy_reference", "surveillance_required", "surveillance_plan_reference", "authorization_evidence", "authorization_evidence_sha256", "conflict_assessment_evidence", "conflict_assessment_evidence_sha256", "legal_applicability_evidence", "legal_applicability_evidence_sha256", "approver_qualification_evidence", "approver_qualification_evidence_sha256", "approver_id", "approved_at", "expires_at"],
  "properties": {
    "engagement_version": {"const": "1.1.0"},
    "engagement_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved", "closed", "withdrawn"]},
    "cavadalabs_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["developer", "provider", "deployer", "evaluator", "testing-laboratory", "scheme-owner", "certification-body"]}},
    "counterparty_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "name", "version", "dataset_sha256", "rubric_sha256", "suite_config_sha256"],
      "properties": {
        "protocol_version": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dataset_sha256": {"$ref": "#/$defs/hash"},
        "rubric_sha256": {"$ref": "#/$defs/hash"},
        "suite_config_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_model", "revision"],
      "properties": {"expected_model": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}
    },
    "execution_owner_id": {"type": "string", "minLength": 1},
    "commercial_owner_id": {"type": "string", "minLength": 1},
    "system_owner_reference": {"type": "string", "minLength": 1},
    "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requested_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "permitted_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prohibited_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "conflicts_assessed": {"type": "boolean"},
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "complaints_process_reference": {"type": "string", "minLength": 1},
    "appeals_process_reference": {"type": "string", "minLength": 1},
    "correction_revocation_reference": {"type": "string", "minLength": 1},
    "disclosure_policy_reference": {"type": "string", "minLength": 1},
    "surveillance_required": {"type": "boolean"},
    "surveillance_plan_reference": {"type": "string"},
    "authorization_evidence": {"type": "string", "minLength": 1},
    "authorization_evidence_sha256": {"$ref": "#/$defs/hash"},
    "conflict_assessment_evidence": {"type": "string", "minLength": 1},
    "conflict_assessment_evidence_sha256": {"$ref": "#/$defs/hash"},
    "legal_applicability_evidence": {"type": "string", "minLength": 1},
    "legal_applicability_evidence_sha256": {"$ref": "#/$defs/hash"},
    "approver_qualification_evidence": {"type": "string", "minLength": 1},
    "approver_qualification_evidence_sha256": {"$ref": "#/$defs/hash"},
    "approver_id": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
