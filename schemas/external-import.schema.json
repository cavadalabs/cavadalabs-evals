{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/external-import/1.0.0",
  "title": "CavadaLabs External Benchmark Import",
  "type": "object",
  "required": ["adapter_version", "source", "suite", "results"],
  "properties": {
    "adapter_version": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "required": ["name", "version", "commit", "license", "dataset_sha256", "evaluator_sha256", "invocation"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "invocation": {"type": "string", "minLength": 1}
      }
    },
    "suite": {"type": "object"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "status"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "scored", "invalid", "error", "skipped"]}
        }
      }
    }
  }
}
