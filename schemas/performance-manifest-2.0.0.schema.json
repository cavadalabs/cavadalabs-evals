{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/performance-manifest/2.0.0",
  "title": "CavadaLabs LLM Performance Campaign Manifest 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "performance_protocol_version",
    "protocol_sha256",
    "plan_version",
    "report_version",
    "run_id",
    "status",
    "official_requested",
    "officially_valid",
    "started_at",
    "plan",
    "workload",
    "runtime",
    "system_evidence",
    "execution_record",
    "engagement",
    "source",
    "environment",
    "planned_requests",
    "planned_cells"
  ],
  "properties": {
    "performance_protocol_version": {"const": "2.0.0"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "plan_version": {"const": "2.0.0"},
    "report_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "completed", "completed-with-errors", "invalid-loadgen", "aborted", "cancelled"]},
    "official_requested": {"type": "boolean"},
    "officially_valid": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "abort_reason": {"type": "string", "minLength": 1},
    "plan": {"$ref": "#/$defs/plan"},
    "workload": {"$ref": "#/$defs/workload"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "system_evidence": {"oneOf": [{"$ref": "#/$defs/systemEvidence"}, {"type": "null"}]},
    "execution_record": {"oneOf": [{"$ref": "#/$defs/executionRecord"}, {"type": "null"}]},
    "engagement": {"oneOf": [{"$ref": "#/$defs/engagement"}, {"type": "null"}]},
    "source": {"$ref": "#/$defs/source"},
    "environment": {"$ref": "#/$defs/environment"},
    "planned_requests": {"type": "integer", "minimum": 0},
    "planned_cells": {"type": "integer", "minimum": 1},
    "requests": {"type": "integer", "minimum": 0},
    "tokens": {"type": "number", "minimum": 0},
    "token_usage": {"$ref": "#/$defs/tokenUsage"},
    "estimated_cost": {"oneOf": [{"$ref": "#/$defs/estimatedCost"}, {"type": "null"}]},
    "cells": {"$ref": "#/$defs/cells"},
    "warmups": {"$ref": "#/$defs/warmups"},
    "request_reconciliation": {"$ref": "#/$defs/reconciliation"},
    "artifacts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safeRelativePath"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["completed", "completed-with-errors", "invalid-loadgen"]}}, "required": ["status"]},
      "then": {"required": ["finished_at", "requests", "tokens", "token_usage", "estimated_cost", "cells", "warmups", "request_reconciliation", "artifacts"]}
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "cells": {"properties": {"with_errors": {"const": 0}, "invalid_loadgen": {"const": 0}}},
          "warmups": {"properties": {"errors": {"const": 0}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "invalid-loadgen"}}, "required": ["status"]},
      "then": {"properties": {"cells": {"properties": {"invalid_loadgen": {"minimum": 1}}}, "officially_valid": {"const": false}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["aborted", "cancelled"]}}, "required": ["status"]},
      "then": {"required": ["finished_at", "abort_reason", "requests", "tokens", "token_usage", "request_reconciliation", "artifacts"]}
    },
    {
      "if": {"properties": {"official_requested": {"const": true}}, "required": ["official_requested"]},
      "then": {
        "properties": {
          "system_evidence": {"$ref": "#/$defs/restrictedSystemEvidence"},
          "execution_record": {"$ref": "#/$defs/executionRecord"},
          "engagement": {"$ref": "#/$defs/engagement"},
          "source": {"properties": {"commit": {"pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}, "dirty": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"officially_valid": {"const": true}}, "required": ["officially_valid"]},
      "then": {
        "properties": {
          "official_requested": {"const": true},
          "status": {"const": "completed"},
          "system_evidence": {"$ref": "#/$defs/restrictedSystemEvidence"},
          "execution_record": {"$ref": "#/$defs/executionRecord"},
          "engagement": {"$ref": "#/$defs/engagement"},
          "request_reconciliation": {"properties": {"campaign_complete": {"const": true}}}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "safeRelativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "loadGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_dispatch_rate_fraction", "maximum_dispatch_lag_p95_ms", "maximum_dispatch_lag_ms"],
      "properties": {
        "minimum_dispatch_rate_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maximum_dispatch_lag_p95_ms": {"type": "number", "minimum": 0},
        "maximum_dispatch_lag_ms": {"type": "number", "minimum": 0}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "sha256", "profile", "data_classification", "load_generator"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "revision": {"$ref": "#/$defs/semanticVersion"},
        "sha256": {"$ref": "#/$defs/hash"},
        "profile": {"const": "llm-serving-v2"},
        "data_classification": {"enum": ["public", "synthetic"]},
        "open_loop_arrival_distribution": {"enum": ["fixed", "poisson"]},
        "execution_seed": {"type": "integer", "minimum": 0},
        "minimum_p99_observations": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "load_generator": {"$ref": "#/$defs/loadGenerator"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "mode", "sha256", "asset_set_sha256", "assets", "cases"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "revision": {"$ref": "#/$defs/semanticVersion"},
        "mode": {"enum": ["iso-prompt", "iso-token"]},
        "prefix_cache_policy": {"enum": ["diverse", "shared", "unspecified"]},
        "sha256": {"$ref": "#/$defs/hash"},
        "asset_set_sha256": {"$ref": "#/$defs/hash"},
        "assets": {"type": "object", "propertyNames": {"$ref": "#/$defs/safeRelativePath"}, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "cases": {"type": "integer", "minimum": 1}
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "source", "effective_at", "input_per_million", "output_per_million"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "effective_at": {"type": "string", "minLength": 1},
        "input_per_million": {"type": "number", "minimum": 0},
        "output_per_million": {"type": "number", "minimum": 0}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_version", "id", "endpoint", "request_model", "expected_model", "model_revision", "api_key_env", "engine", "engine_revision", "model_artifact_revision", "dtype", "quantization", "gpu_count", "gpu_model", "tensor_parallel", "max_context_tokens", "launch_command_sanitized", "sha256", "pricing"],
      "properties": {
        "runtime_version": {"const": "1.0.0"},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "endpoint": {"type": "string", "pattern": "^https?://[^?#]+$"},
        "request_model": {"type": "string", "minLength": 1},
        "expected_model": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "api_key_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "engine": {"type": "string", "minLength": 1},
        "engine_revision": {"type": "string", "minLength": 1},
        "model_artifact_revision": {"$ref": "#/$defs/hash"},
        "dtype": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1},
        "gpu_count": {"type": "integer", "minimum": 1},
        "gpu_model": {"type": "string", "minLength": 1},
        "tensor_parallel": {"type": "integer", "minimum": 1},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "container_image_digest": {"type": "string", "pattern": "^(?:|sha256:[a-fA-F0-9]{64})$"},
        "launch_command_sanitized": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "pricing": {"oneOf": [{"$ref": "#/$defs/pricing"}, {"type": "null"}]}
      }
    },
    "systemEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "sha256", "projection", "collected_at"],
      "properties": {
        "configuration_id": {"type": "string", "pattern": "^cfg-sha256:[a-f0-9]{64}$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "projection": {"enum": ["restricted", "public"]},
        "collected_at": {"type": "string", "format": "date-time"}
      }
    },
    "restrictedSystemEvidence": {"allOf": [{"$ref": "#/$defs/systemEvidence"}, {"properties": {"projection": {"const": "restricted"}}}]},
    "executionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_version", "engagement_id", "execution_owner_id", "sha256", "recorded_at"],
      "properties": {
        "record_version": {"const": "1.0.0"},
        "engagement_id": {"type": "string", "minLength": 1},
        "execution_owner_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagement_version", "engagement_id", "status", "execution_owner_id", "protocol_sha256", "plan_sha256", "workload_sha256", "runtime_sha256", "system_evidence_sha256", "configuration_id", "approved_at", "expires_at", "sha256"],
      "properties": {
        "engagement_version": {"const": "1.0.0"},
        "engagement_id": {"type": "string", "minLength": 1},
        "status": {"const": "approved"},
        "execution_owner_id": {"type": "string", "minLength": 1},
        "protocol_sha256": {"$ref": "#/$defs/hash"},
        "plan_sha256": {"$ref": "#/$defs/hash"},
        "workload_sha256": {"$ref": "#/$defs/hash"},
        "runtime_sha256": {"$ref": "#/$defs/hash"},
        "system_evidence_sha256": {"$ref": "#/$defs/hash"},
        "configuration_id": {"type": "string", "pattern": "^cfg-sha256:[a-f0-9]{64}$"},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "status_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})?$"},
        "dirty": {"type": "boolean"},
        "status_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "hardware", "uv_lock_sha256"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine", "processor", "cpu_count"],
          "properties": {
            "machine": {"type": "string"},
            "processor": {"type": "string"},
            "cpu_count": {"type": ["integer", "null"], "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1},
            "gpus": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "uv_lock_sha256": {"type": "string", "pattern": "^(?:[a-f0-9]{64})?$"}
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {"input": {"type": "number", "minimum": 0}, "output": {"type": "number", "minimum": 0}, "total": {"type": "number", "minimum": 0}}
    },
    "estimatedCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "source", "effective_at", "includes_warmup"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "effective_at": {"type": "string", "minLength": 1},
        "includes_warmup": {"const": true}
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "completed", "with_errors", "invalid_loadgen", "skipped", "slo_passed", "slo_failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "with_errors": {"type": "integer", "minimum": 0},
        "invalid_loadgen": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "slo_passed": {"type": "integer", "minimum": 0},
        "slo_failed": {"type": "integer", "minimum": 0}
      }
    },
    "warmups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "successes", "errors"],
      "properties": {"total": {"type": "integer", "minimum": 0}, "successes": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}}
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "scheduled", "accepted", "responses", "warmup_outcomes", "measured_outcomes", "terminal_outcomes", "ledgers_complete", "campaign_complete"],
      "properties": {
        "planned": {"type": "integer", "minimum": 0},
        "scheduled": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "responses": {"type": "integer", "minimum": 0},
        "warmup_outcomes": {"type": "integer", "minimum": 0},
        "measured_outcomes": {"type": "integer", "minimum": 0},
        "terminal_outcomes": {"type": "integer", "minimum": 0},
        "ledgers_complete": {"type": "boolean"},
        "campaign_complete": {"type": "boolean"}
      }
    }
  }
}
