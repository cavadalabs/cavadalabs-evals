{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/performance-system-evidence/1.0.0",
  "title": "CavadaLabs Performance System Evidence",
  "description": "Versioned evidence for the complete server, serving stack, load generator, and network path used by an LLM serving run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "configuration_id",
    "projection",
    "collected_at",
    "collection_method",
    "server",
    "software",
    "serving",
    "load_generator",
    "network",
    "artifacts",
    "unavailable"
  ],
  "properties": {
    "evidence_version": {"const": "1.0.0"},
    "configuration_id": {"type": "string", "pattern": "^cfg-sha256:[a-f0-9]{64}$"},
    "projection": {"enum": ["restricted", "public"]},
    "collected_at": {"type": "string", "format": "date-time"},
    "collection_method": {"enum": ["manual", "automated", "mixed"]},
    "server": {"$ref": "#/$defs/server"},
    "software": {"$ref": "#/$defs/software"},
    "serving": {"$ref": "#/$defs/serving"},
    "load_generator": {"$ref": "#/$defs/loadGenerator"},
    "network": {"$ref": "#/$defs/network"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "unavailable": {
      "type": "object",
      "description": "Every null field must have exactly one JSON Pointer here explaining why the fact is unavailable or redacted. Enforced by the runtime validator.",
      "propertyNames": {"pattern": "^/"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"projection": {"const": "public"}}},
      "then": {
        "properties": {
          "server": {
            "properties": {
              "host_id": {"type": "null"},
              "accelerators": {
                "items": {"properties": {"uuid": {"type": "null"}, "pci_bus_id": {"type": "null"}}}
              }
            }
          },
          "load_generator": {"properties": {"host_id": {"type": "null"}}},
          "network": {
            "properties": {
              "endpoint_host": {"type": "null"},
              "endpoint_port": {"type": "null"},
              "route": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"network": {"properties": {"relationship": {"const": "same-host"}}}}},
      "then": {"properties": {"load_generator": {"properties": {"colocated_with_server": {"const": true}}}}},
      "else": {"properties": {"load_generator": {"properties": {"colocated_with_server": {"const": false}}}}}
    }
  ],
  "$defs": {
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "nullablePositiveInteger": {"type": ["integer", "null"], "minimum": 1},
    "nullablePositiveNumber": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kernel"],
      "properties": {
        "name": {"$ref": "#/$defs/nullableText"},
        "version": {"$ref": "#/$defs/nullableText"},
        "kernel": {"$ref": "#/$defs/nullableText"}
      }
    },
    "serverCpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "architecture", "sockets", "physical_cores", "logical_cores"],
      "properties": {
        "model": {"$ref": "#/$defs/nullableText"},
        "architecture": {"$ref": "#/$defs/nullableText"},
        "sockets": {"$ref": "#/$defs/nullablePositiveInteger"},
        "physical_cores": {"$ref": "#/$defs/nullablePositiveInteger"},
        "logical_cores": {"$ref": "#/$defs/nullablePositiveInteger"}
      }
    },
    "loadCpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "architecture", "logical_cores"],
      "properties": {
        "model": {"$ref": "#/$defs/nullableText"},
        "architecture": {"$ref": "#/$defs/nullableText"},
        "logical_cores": {"$ref": "#/$defs/nullablePositiveInteger"}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_bytes"],
      "properties": {
        "total_bytes": {"$ref": "#/$defs/nullablePositiveInteger"}
      }
    },
    "numa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "policy"],
      "properties": {
        "nodes": {"$ref": "#/$defs/nullablePositiveInteger"},
        "policy": {"$ref": "#/$defs/nullableText"}
      }
    },
    "accelerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "vendor",
        "model",
        "uuid",
        "vram_bytes",
        "pci_bus_id",
        "power_limit_watts",
        "graphics_clock_limit_mhz",
        "memory_clock_limit_mhz"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "uuid": {"$ref": "#/$defs/nullableText"},
        "vram_bytes": {"$ref": "#/$defs/nullablePositiveInteger"},
        "pci_bus_id": {"$ref": "#/$defs/nullableText"},
        "power_limit_watts": {"$ref": "#/$defs/nullablePositiveNumber"},
        "graphics_clock_limit_mhz": {"$ref": "#/$defs/nullablePositiveNumber"},
        "memory_clock_limit_mhz": {"$ref": "#/$defs/nullablePositiveNumber"}
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "os", "cpu", "memory", "numa", "accelerators", "accelerator_topology"],
      "properties": {
        "host_id": {"$ref": "#/$defs/nullableText"},
        "os": {"$ref": "#/$defs/os"},
        "cpu": {"$ref": "#/$defs/serverCpu"},
        "memory": {"$ref": "#/$defs/memory"},
        "numa": {"$ref": "#/$defs/numa"},
        "accelerators": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/accelerator"}}
          ]
        },
        "accelerator_topology": {"$ref": "#/$defs/nullableText"}
      }
    },
    "nameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/nullableText"},
        "version": {"$ref": "#/$defs/nullableText"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "binary_sha256", "container_image_digest"],
      "anyOf": [
        {"required": ["binary_sha256"], "properties": {"binary_sha256": {"$ref": "#/$defs/sha256"}}},
        {"required": ["container_image_digest"], "properties": {"container_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "binary_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "container_image_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "artifact_sha256", "dtype", "quantization"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "dtype": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "compute_runtime", "engine", "model"],
      "properties": {
        "driver": {"$ref": "#/$defs/nameVersion"},
        "compute_runtime": {"$ref": "#/$defs/nameVersion"},
        "engine": {"$ref": "#/$defs/engine"},
        "model": {"$ref": "#/$defs/model"}
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_command_sanitized",
        "max_context_tokens",
        "max_batch_size",
        "max_batch_tokens",
        "continuous_batching",
        "prefix_cache",
        "kv_cache_dtype",
        "tensor_parallel",
        "pipeline_parallel",
        "data_parallel",
        "parallel_slots"
      ],
      "properties": {
        "launch_command_sanitized": {"type": "string", "minLength": 1},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "max_batch_size": {"type": "integer", "minimum": 1},
        "max_batch_tokens": {"$ref": "#/$defs/nullablePositiveInteger"},
        "continuous_batching": {"type": "boolean"},
        "prefix_cache": {"type": "boolean"},
        "kv_cache_dtype": {"type": "string", "minLength": 1},
        "tensor_parallel": {"type": "integer", "minimum": 1},
        "pipeline_parallel": {"type": "integer", "minimum": 1},
        "data_parallel": {"type": "integer", "minimum": 1},
        "parallel_slots": {"type": "integer", "minimum": 1}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "loadGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "os", "cpu", "memory", "client", "colocated_with_server"],
      "properties": {
        "host_id": {"$ref": "#/$defs/nullableText"},
        "os": {"$ref": "#/$defs/os"},
        "cpu": {"$ref": "#/$defs/loadCpu"},
        "memory": {"$ref": "#/$defs/memory"},
        "client": {"$ref": "#/$defs/client"},
        "colocated_with_server": {"type": "boolean"}
      }
    },
    "rtt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "samples", "median", "p95", "measured_at"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "samples": {"type": "integer", "minimum": 1},
        "median": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "measured_at": {"type": "string", "format": "date-time"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "transport", "endpoint_host", "endpoint_port", "route", "rtt_ms"],
      "properties": {
        "relationship": {"enum": ["same-host", "direct-lan", "routed-lan", "wan", "tunnel"]},
        "transport": {"enum": ["tcp", "tls", "unix-socket"]},
        "endpoint_host": {"$ref": "#/$defs/nullableText"},
        "endpoint_port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "route": {"$ref": "#/$defs/nullableText"},
        "rtt_ms": {
          "oneOf": [{"$ref": "#/$defs/rtt"}, {"type": "null"}]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
