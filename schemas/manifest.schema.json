{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/manifest/1.0.0",
  "title": "CavadaLabs Evaluation Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "protocol_sha256",
    "schema_version",
    "report_version",
    "metric_version",
    "adapter_contract_version",
    "run_id",
    "status",
    "official_requested",
    "started_at",
    "suite",
    "target",
    "judge",
    "judge_qualification",
    "engagement",
    "external_judge_authorized",
    "external_authorization",
    "artifact_security",
    "parameters",
    "pricing",
    "source",
    "environment",
    "signing",
    "reproduction_command",
    "public_reproduction_command"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "1.0.0"},
    "metric_version": {"const": "1.0.0"},
    "adapter_contract_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "passed", "failed", "invalid", "cancelled"]},
    "official_requested": {"type": "boolean"},
    "official": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "resumed_at": {"type": "array", "items": {"type": "string", "format": "date-time"}},
    "abort_reason": {"type": "string"},
    "suite": {"$ref": "#/$defs/suite"},
    "target": {"$ref": "#/$defs/target"},
    "judge": {"$ref": "#/$defs/judge"},
    "judge_qualification": {"oneOf": [{"$ref": "#/$defs/judgeQualification"}, {"type": "null"}]},
    "engagement": {"oneOf": [{"$ref": "#/$defs/engagement"}, {"type": "null"}]},
    "external_judge_authorized": {"type": "boolean"},
    "external_authorization": {"oneOf": [{"$ref": "#/$defs/externalAuthorization"}, {"type": "null"}]},
    "artifact_security": {"$ref": "#/$defs/artifactSecurity"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "pricing": {"oneOf": [{"$ref": "#/$defs/pricing"}, {"type": "null"}]},
    "source": {"$ref": "#/$defs/source"},
    "environment": {"$ref": "#/$defs/environment"},
    "signing": {"$ref": "#/$defs/signing"},
    "reproduction_command": {"type": "string", "minLength": 1},
    "public_reproduction_command": {"type": "string", "minLength": 1},
    "metrics": {"type": "object"},
    "artifacts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safeRelativePath"},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"official_requested": {"const": true}}, "required": ["official_requested"]},
      "then": {
        "properties": {
          "engagement": {"$ref": "#/$defs/engagement"},
          "judge_qualification": {"$ref": "#/$defs/judgeQualification"},
          "parameters": {
            "properties": {
              "mode": {"const": "official"},
              "case_review_policy": {"const": "approved-only"},
              "max_cases": {"const": 0}
            }
          },
          "source": {
            "properties": {
              "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
              "dirty": {"const": false}
            }
          },
          "target": {
            "properties": {
              "expected_reported_model": {"type": "string", "minLength": 1},
              "revision": {"$ref": "#/$defs/immutableRevision"},
              "endpoint": {"type": "string", "pattern": "^[^?#]+$"}
            }
          },
          "judge": {
            "properties": {
              "revision": {"$ref": "#/$defs/immutableRevision"},
              "endpoint": {"type": "string", "pattern": "^[^?#]+$"},
              "models": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/judgeModel"},
                    {"properties": {"revision": {"$ref": "#/$defs/immutableRevision"}}}
                  ]
                }
              }
            }
          },
          "resumed_at": false
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["passed", "failed"]}}, "required": ["status"]},
      "then": {"required": ["finished_at", "abort_reason", "metrics", "artifacts", "official"]}
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}, "required": ["status"]},
      "then": {"required": ["finished_at", "abort_reason"]}
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {"properties": {"abort_reason": {"const": ""}, "metrics": {"properties": {"officially_valid": {"const": true}}}}}
    },
    {
      "if": {"properties": {"official": {"const": true}}, "required": ["official"]},
      "then": {"properties": {"official_requested": {"const": true}, "status": {"const": "passed"}}}
    },
    {
      "if": {
        "properties": {"official_requested": {"const": true}, "external_judge_authorized": {"const": true}},
        "required": ["official_requested", "external_judge_authorized"]
      },
      "then": {"properties": {"external_authorization": {"$ref": "#/$defs/externalAuthorization"}}}
    },
    {
      "if": {
        "properties": {"official_requested": {"const": true}, "external_judge_authorized": {"const": false}},
        "required": ["official_requested", "external_judge_authorized"]
      },
      "then": {"properties": {"external_authorization": {"type": "null"}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "immutableRevision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64}|sha256:[a-f0-9]{64}|opaque-immutable:[A-Za-z0-9][A-Za-z0-9._:@/+~-]{7,})$"
    },
    "safeRelativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "nullableText": {"type": ["string", "null"]},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "dataset_sha256", "rubric_sha256", "suite_config_sha256", "data_classification", "profile"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "dataset_sha256": {"$ref": "#/$defs/hash"},
        "rubric_sha256": {"$ref": "#/$defs/hash"},
        "suite_config_sha256": {"$ref": "#/$defs/hash"},
        "data_classification": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "expected_reported_model", "revision", "endpoint", "request_model", "api_key_env", "kind", "capabilities", "recorded_responses_sha256"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "expected_reported_model": {"type": "string"},
        "revision": {"type": "string"},
        "endpoint": {"type": "string"},
        "request_model": {"$ref": "#/$defs/nullableText"},
        "api_key_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "kind": {"enum": ["json", "openai", "recorded"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "recorded_responses_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    },
    "judgeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "expected_model", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "expected_model": {"type": "string", "minLength": 1},
        "revision": {"type": "string"}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_model", "expected_reported_model", "revision", "endpoint", "prompt_sha256", "response_schema", "temperature", "max_tokens", "judge_repetitions", "models", "consensus", "api_key_env"],
      "properties": {
        "requested_model": {"type": "string", "minLength": 1},
        "expected_reported_model": {"type": "string", "minLength": 1},
        "revision": {"type": "string"},
        "endpoint": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/hash"},
        "response_schema": {"const": "judgment.schema.json@1.0.0"},
        "temperature": {"const": 0},
        "max_tokens": {"type": "integer", "minimum": 1},
        "judge_repetitions": {"type": "integer", "minimum": 1},
        "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/judgeModel"}},
        "consensus": {"enum": ["majority", "unanimous"]},
        "api_key_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "judgeQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualification_sha256", "approval_sha256", "approval_id", "approver_id", "approved_at", "expires_at", "approver_qualification_evidence_sha256"],
      "properties": {
        "qualification_sha256": {"$ref": "#/$defs/hash"},
        "approval_sha256": {"$ref": "#/$defs/hash"},
        "approval_id": {"type": "string", "minLength": 1},
        "approver_id": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "approver_qualification_evidence_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagement_id", "sha256", "status", "cavadalabs_roles", "jurisdictions", "permitted_claims", "prohibited_claims", "execution_owner_id", "commercial_owner_id", "approved_at", "expires_at", "authorization_evidence_sha256", "conflict_assessment_evidence_sha256", "legal_applicability_evidence_sha256", "approver_qualification_evidence_sha256"],
      "properties": {
        "engagement_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "status": {"const": "approved"},
        "cavadalabs_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "jurisdictions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "permitted_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "execution_owner_id": {"type": "string", "minLength": 1},
        "commercial_owner_id": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "authorization_evidence_sha256": {"$ref": "#/$defs/hash"},
        "conflict_assessment_evidence_sha256": {"$ref": "#/$defs/hash"},
        "legal_applicability_evidence_sha256": {"$ref": "#/$defs/hash"},
        "approver_qualification_evidence_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "externalAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_id", "approver", "purpose", "destinations", "expires_at", "sha256"],
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "region", "purpose"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "region": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1}
            }
          }
        },
        "expires_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "artifactSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "retention", "storage_attestation", "encryption_state", "immutability_state"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "retention": {"type": ["object", "string", "null"]},
        "storage_attestation": {"oneOf": [{"$ref": "#/$defs/storageAttestation"}, {"type": "null"}]},
        "encryption_state": {"enum": ["attested", "not-attested"]},
        "immutability_state": {"enum": ["attested", "not-attested"]}
      }
    },
    "storageAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_id", "approver", "encryption_at_rest", "immutability", "effective_at", "expires_at", "sha256"],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "encryption_at_rest": {"type": "boolean"},
        "immutability": {"type": "boolean"},
        "effective_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "case_review_policy", "preset", "preset_version", "repetitions", "judge_repetitions", "max_cases", "selected_cases", "timeout_seconds", "max_target_calls", "max_judge_calls", "max_total_tokens", "max_elapsed_seconds", "max_estimated_cost", "non_inferiority_margin", "concurrency", "requests_per_second", "progress_events", "case_order_policy", "case_order_sha256", "cache"],
      "properties": {
        "mode": {"enum": ["smoke", "regression", "candidate", "official", "redteam", "performance", "load", "soak", "offline", "monitoring"]},
        "case_review_policy": {"enum": ["approved-only", "approved-and-needs-review"]},
        "preset": {"type": "string"},
        "preset_version": {"type": ["string", "null"]},
        "repetitions": {"type": "integer", "minimum": 1},
        "judge_repetitions": {"type": "integer", "minimum": 1},
        "max_cases": {"type": "integer", "minimum": 0},
        "selected_cases": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_target_calls": {"type": "integer", "minimum": 0},
        "max_judge_calls": {"type": "integer", "minimum": 0},
        "max_total_tokens": {"type": "integer", "minimum": 0},
        "max_elapsed_seconds": {"type": "number", "minimum": 0},
        "max_estimated_cost": {"type": "number", "minimum": 0},
        "non_inferiority_margin": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
        "requests_per_second": {"type": "number", "minimum": 0},
        "progress_events": {"type": "boolean"},
        "case_order_policy": {"type": "string", "minLength": 1},
        "case_order_sha256": {"$ref": "#/$defs/hash"},
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "judge"],
          "properties": {"target": {"const": "disabled"}, "judge": {"const": "disabled"}}
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "source", "effective_at", "input_per_million", "output_per_million"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "effective_at": {"type": "string", "minLength": 1},
        "input_per_million": {"type": "number", "minimum": 0},
        "output_per_million": {"type": "number", "minimum": 0},
        "judge_input_per_million": {"type": "number", "minimum": 0},
        "judge_output_per_million": {"type": "number", "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "status_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})?$"},
        "dirty": {"type": "boolean"},
        "status_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "hardware", "uv_lock_sha256"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine", "processor", "cpu_count"],
          "properties": {
            "machine": {"type": "string"},
            "processor": {"type": "string"},
            "cpu_count": {"type": ["integer", "null"], "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1},
            "gpus": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "uv_lock_sha256": {"type": "string", "pattern": "^(?:[a-f0-9]{64})?$"}
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_env", "key_id"],
      "properties": {
        "key_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "key_id": {"type": "string"}
      }
    }
  }
}
