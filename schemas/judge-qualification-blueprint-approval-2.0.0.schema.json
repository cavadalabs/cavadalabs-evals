{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/judge-qualification-blueprint-approval/2.0.0",
  "title": "CavadaLabs Independent Judge Qualification Blueprint Approval v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_version", "approval_id", "scope", "protocol_version", "subject", "suite",
    "decision", "independent", "approver_id", "approver_qualification_evidence",
    "conflict_of_interest_assessment", "conflicts_resolved", "decision_rationale",
    "permitted_claim_scope", "approved_at", "expires_at", "revoked_at", "revocation_reason"
  ],
  "properties": {
    "approval_version": {"const": "2.0.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "scope": {"const": "judge-qualification-blueprint"},
    "protocol_version": {"const": "1.0.0"},
    "subject": {"$ref": "#/$defs/artifactReference"},
    "suite": {"$ref": "#/$defs/suite"},
    "decision": {"enum": ["approved", "rejected", "withdrawn", "revoked"]},
    "independent": {"type": "boolean"},
    "approver_id": {"type": "string", "minLength": 1},
    "approver_qualification_evidence": {"$ref": "#/$defs/artifactReference"},
    "conflict_of_interest_assessment": {"type": "string", "minLength": 1},
    "conflicts_resolved": {"type": "boolean"},
    "decision_rationale": {"type": "string", "minLength": 1},
    "permitted_claim_scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "revocation_reason": {"type": "string"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "artifact_type", "schema_version"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "artifact_type": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "dataset_sha256", "rubric_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "dataset_sha256": {"$ref": "#/$defs/hash"},
        "rubric_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
