{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/case/1.1.0",
  "title": "CavadaLabs Evaluation Case",
  "type": "object",
  "required": ["id", "input", "category", "risk_domain", "severity", "language", "locale", "split", "tags", "expected_behavior", "expected_behavior_reason", "source", "review"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "input": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentPart"}}
      ]
    },
    "category": {"type": "string", "minLength": 1},
    "risk_domain": {"enum": ["quality", "security", "privacy", "safety", "reliability", "performance", "fairness"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "language": {"type": "string", "minLength": 2},
    "locale": {"type": "string", "minLength": 2},
    "split": {"enum": ["public", "practice", "calibration", "holdout"]},
    "weight": {"type": "number", "exclusiveMinimum": 0},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "operating_condition": {"enum": ["best-case", "normal", "boundary", "adversarial", "perturbed", "multi-turn", "distribution-shift"]},
    "distribution_shift_dimension": {"type": "string", "minLength": 1},
    "distribution_shift_reference_id": {"type": "string", "minLength": 1},
    "scenario_role": {"enum": ["primary", "variant"]},
    "scenario_reference_id": {"type": "string", "minLength": 1},
    "performance_phase": {"enum": ["cold", "warmup", "steady", "soak"]},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant", "tool"]},
          "content": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentPart"}}]}
        }
      }
    },
    "expected_behavior": {"enum": ["answer", "refuse", "abstain", "redirect", "safe_complete"]},
    "expected_behavior_reason": {"type": "string", "minLength": 1},
    "expected_retrieval_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retrieval_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {
      "type": "object",
      "required": ["origin"],
      "properties": {"origin": {"type": "string", "minLength": 1}}
    },
    "review": {
      "type": "object",
      "required": ["status", "method"],
      "properties": {
        "status": {"enum": ["approved", "needs_review", "rejected"]},
        "method": {"type": "string", "minLength": 1}
      }
    }
  },
  "dependentRequired": {"retrieval_recall_min": ["expected_retrieval_ids"]},
  "$defs": {
    "contentPart": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["text", "image", "audio", "video", "document", "tool_call", "tool_result"]},
        "text": {"type": "string"},
        "asset": {"type": "string"},
        "mime_type": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "name": {"type": "string"},
        "arguments": {"type": "object"},
        "result": {}
      }
    }
  }
}
