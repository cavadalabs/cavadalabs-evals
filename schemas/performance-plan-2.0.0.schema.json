{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/performance-plan/2.0.0",
  "title": "CavadaLabs LLM Performance Plan 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "revision", "name", "description", "profile", "data_classification", "workload", "generation", "execution", "load_generator", "limits", "slo", "scenarios"],
  "properties": {
    "plan_version": {"const": "2.0.0"},
    "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "description": {"type": "string", "minLength": 1},
    "profile": {"const": "llm-serving-v2"},
    "data_classification": {"enum": ["public", "synthetic"]},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "path", "sha256", "mode", "input_token_tolerance_fraction"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "mode": {"enum": ["iso-prompt", "iso-token"]},
        "prefix_cache_policy": {"enum": ["diverse", "shared", "unspecified"]},
        "input_token_tolerance_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "temperature"],
      "properties": {
        "stream": {"const": true},
        "temperature": {"const": 0},
        "request_defaults": {"type": "object"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "warmup_requests", "measured_requests", "open_loop_duration_seconds", "bootstrap_samples", "seed", "randomize_cells", "cooldown_seconds", "max_in_flight"],
      "properties": {
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
        "warmup_requests": {"type": "integer", "minimum": 0},
        "measured_requests": {"type": "integer", "minimum": 1},
        "open_loop_duration_seconds": {"type": "number", "minimum": 0},
        "open_loop_arrival_distribution": {"enum": ["fixed", "poisson"]},
        "bootstrap_samples": {"type": "integer", "minimum": 100},
        "seed": {"type": "integer", "minimum": 0},
        "randomize_cells": {"type": "boolean"},
        "cooldown_seconds": {"type": "number", "minimum": 0},
        "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "load_generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_dispatch_rate_fraction", "maximum_dispatch_lag_p95_ms", "maximum_dispatch_lag_ms"],
      "properties": {
        "minimum_dispatch_rate_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maximum_dispatch_lag_p95_ms": {"type": "number", "minimum": 0},
        "maximum_dispatch_lag_ms": {"type": "number", "minimum": 0}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_requests", "max_total_tokens", "max_campaign_seconds", "max_context_tokens", "max_output_tokens"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_requests": {"type": "integer", "minimum": 1},
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_campaign_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_context_tokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 131072}
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttft_p95_ms", "e2e_p99_ms", "goodput_ttft_ms", "goodput_e2e_ms", "maximum_error_rate", "minimum_output_tokens_fraction"],
      "properties": {
        "ttft_p95_ms": {"type": "number", "exclusiveMinimum": 0},
        "e2e_p99_ms": {"type": "number", "exclusiveMinimum": 0},
        "goodput_ttft_ms": {"type": "number", "exclusiveMinimum": 0},
        "goodput_e2e_ms": {"type": "number", "exclusiveMinimum": 0},
        "maximum_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_output_tokens_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_p99_observations": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "arrival", "context_tokens", "output_tokens"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "arrival": {"enum": ["closed-loop", "open-loop"]},
          "context_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
          "output_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
          "concurrency": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
          "request_rates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
          "warmup_requests": {"type": "integer", "minimum": 0},
          "measured_requests": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
        },
        "allOf": [
          {
            "if": {"properties": {"arrival": {"const": "closed-loop"}}, "required": ["arrival"]},
            "then": {"required": ["concurrency"], "not": {"anyOf": [{"required": ["request_rates"]}, {"required": ["duration_seconds"]}]}}
          },
          {
            "if": {"properties": {"arrival": {"const": "open-loop"}}, "required": ["arrival"]},
            "then": {"required": ["request_rates"], "not": {"anyOf": [{"required": ["concurrency"]}, {"required": ["measured_requests"]}]}}
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
