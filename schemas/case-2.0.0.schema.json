{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cavadalabs.com/evals/case/2.0.0",
  "title": "CavadaLabs Evaluation Case v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "input", "category", "risk_domain", "severity", "language", "locale",
    "split", "tags", "expected_behavior", "expected_behavior_reason", "source", "review"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "input": {"$ref": "#/$defs/content"},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/message"}
    },
    "category": {"type": "string", "minLength": 1},
    "risk_domain": {"enum": ["quality", "security", "privacy", "safety", "reliability", "performance", "fairness"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "language": {"type": "string", "minLength": 2},
    "locale": {"type": "string", "minLength": 2},
    "split": {"enum": ["public", "practice", "calibration", "holdout"]},
    "weight": {"type": "number", "exclusiveMinimum": 0},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "operating_condition": {"enum": ["best-case", "normal", "boundary", "adversarial", "perturbed", "multi-turn", "distribution-shift"]},
    "distribution_shift_dimension": {"type": "string", "minLength": 1},
    "distribution_shift_reference_id": {"type": "string", "minLength": 1},
    "scenario_group_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_role": {"enum": ["primary", "variant"]},
    "scenario_reference_id": {"type": "string", "minLength": 1},
    "performance_phase": {"enum": ["cold", "warmup", "steady", "soak"]},
    "expected_behavior": {"enum": ["answer", "refuse", "abstain", "redirect", "safe_complete"]},
    "expected_behavior_reason": {"type": "string", "minLength": 1},
    "expected_output": {"type": "string"},
    "expected_json": {"type": "boolean"},
    "expected_json_value": {"$ref": "#/$defs/jsonValue"},
    "json_schema": {"$ref": "#/$defs/jsonObject"},
    "expected_number": {"type": "number"},
    "numeric_tolerance": {"type": "number", "minimum": 0},
    "expected_set": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "set_f1_min": {"$ref": "#/$defs/rate"},
    "token_f1_min": {"$ref": "#/$defs/rate"},
    "expected_retrieval_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "retrieval_k": {"type": "integer", "minimum": 1},
    "retrieval_minimums": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "expected_tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden_tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_tool_permissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_tool_arguments": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "exact_tool_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "max_tool_calls": {"type": "integer", "minimum": 0},
    "expected_transcript": {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
    "required_terms": {"type": "array", "items": {"type": "string"}},
    "forbidden_terms": {"type": "array", "items": {"type": "string"}},
    "required_regex": {"type": "array", "items": {"type": "string"}},
    "forbidden_regex": {"type": "array", "items": {"type": "string"}},
    "citation_required": {"type": "boolean"},
    "citation_pattern": {"type": "string", "minLength": 1},
    "forbid_pii": {"type": "boolean"},
    "min_chars": {"type": "integer", "minimum": 0},
    "max_chars": {"type": "integer", "minimum": 0},
    "max_character_error_rate": {"$ref": "#/$defs/rate"},
    "max_word_error_rate": {"$ref": "#/$defs/rate"},
    "structured_field_accuracy_min": {"$ref": "#/$defs/rate"},
    "mandatory_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metric_weights": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "soft_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "judge_gold_verdict": {"enum": ["pass", "fail"]},
    "response_length": {"type": "string", "minLength": 1},
    "response_style": {"type": "string", "minLength": 1},
    "probe_type": {"type": "string", "minLength": 1},
    "model_family_alias": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "context": {"type": "array", "items": {"type": "string"}},
    "retrieval_context": {"type": "array", "items": {"type": "string"}},
    "pattern": {"type": "string"},
    "source": {"$ref": "#/$defs/source"},
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "content": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentPart"}}
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant", "tool"]},
        "content": {"$ref": "#/$defs/content"},
        "name": {"type": "string", "minLength": 1},
        "tool_call_id": {"type": "string", "minLength": 1}
      }
    },
    "contentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["text", "image", "audio", "video", "document", "tool_call", "tool_result"]},
        "text": {"type": "string"},
        "asset": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "name": {"type": "string", "minLength": 1},
        "arguments": {"$ref": "#/$defs/jsonObject"},
        "result": {"$ref": "#/$defs/jsonValue"},
        "license": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "personal_data": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "source_case_id": {"type": "string", "minLength": 1},
        "source_run_manifest_sha256": {"$ref": "#/$defs/hash"},
        "gold_evidence_sha256": {"$ref": "#/$defs/hash"},
        "model_family_alias": {"type": "string", "minLength": 1},
        "metadata": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": {"enum": ["approved", "needs_review", "rejected"]},
        "method": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "jsonObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  }
}
